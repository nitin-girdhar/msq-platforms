# identity-service — required environment variables
DATABASE_URL=postgres://lead_svc:LeadSvc_Dev2025@localhost:5432/crm
DATABASE_URL_SERVICE=postgres://root_service:CrmSvc_Dev2025@localhost:5432/crm
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
INTERNAL_SERVICE_SECRET=change-me-to-another-long-random-string
IDENTITY_SERVICE_PORT=4001
LEADS_SERVICE_URL=http://localhost:4002
NODE_ENV=development

# communication-service (SMTP relay) for Team notification emails — account
# created / password reset / branch changed. Fire-and-forget: a failure here
# only logs, it never fails the admin's request. Gated on the acting admin
# holding the admin.team.notify capability.
COMMUNICATION_SERVICE_URL=http://localhost:4005
IDENTITY_COMMUNICATION_SERVICE_TIMEOUT_MS=10000
# Where those emails tell the recipient to sign in — the shared auth-web origin.
# Reuses AUTH_URL (already set for the login redirect); AUTH_WEB_URL also works.
AUTH_URL=http://localhost:3000
# Product name used in the email subject/body. Falls back to SMTP_FROM_NAME.
APP_NAME=MSquare

# Outbound request timeout (ms) - identity-service.
# leads-service reassign-org saga. Long (a branch move can reassign many leads)
# but bounded - identity holds the org/role change open until it returns.
IDENTITY_LEADS_SERVICE_TIMEOUT_MS=30000

# RS256 migration switch. While HS256 is accepted, RS256 buys nothing security-wise:
# JWT_SECRET mints equally valid tokens and must exist wherever tokens are verified.
# Cutover: (1) set JWT_PRIVATE_KEY + JWT_KID on identity-service and JWT_PUBLIC_KEY
# everywhere; (2) wait one full token lifetime; (3) set this to false EVERYWHERE;
# (4) delete JWT_SECRET from everything that does not sign.
# Only the exact string 'false' disables HS256. Setting false without an RSA key makes
# identity-service refuse to boot - deliberately, since it would otherwise sign tokens
# that nothing, including itself, could verify.
JWT_ALLOW_HS256=true
