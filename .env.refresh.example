# Off-site destination for db_scripts/tools/refresh_from_prod.ps1
#
# Copy this to .env.refresh and fill it in. If BACKUP_SSH_HOST, BACKUP_SSH_USER
# or BACKUP_REMOTE_DIR is missing, the upload stage is skipped with a warning
# and the rest of the cycle still runs.
#
# Authentication is by SSH KEY ONLY — the script runs ssh/scp with
# BatchMode=yes so it fails fast instead of hanging on a password prompt.
# Make sure the key is authorised first:
#     ssh-copy-id -i <key>.pub user@backup-host
# and confirm this works with no prompt:
#     ssh -i <key> user@backup-host 'echo ok'

BACKUP_SSH_HOST=backup.example.com
BACKUP_SSH_USER=backupuser
BACKUP_SSH_PORT=22

# Absolute path to the private key on THIS machine.
# Leave blank to use the default ssh identity (~/.ssh/id_rsa etc).
BACKUP_SSH_KEY=C:/Users/you/.ssh/id_ed25519

# Base directory on the backup host. The script creates a dated subdirectory
# under it per run, e.g. /srv/backups/msq-platforms/2026-08-05/
BACKUP_REMOTE_DIR=/srv/backups/msq-platforms
