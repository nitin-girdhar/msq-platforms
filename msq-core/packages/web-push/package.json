{
  "name": "@platform/web-push",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@platform/db": "workspace:*",
    "@platform/logger": "workspace:*",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1",
    "vitest": "^3.0.0"
  }
}
