meta {
  name: Public Get Branches (Partner API)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/public/v1/branches
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{apiClientKey}}
}

docs {
  Requires a key with `branches:read`. Returns tenant branches (id, name,
  brand_name, city, timezone, is_active, country/state/city id + name).
  Optional csv filters: ?branch_id=, ?country_id=, ?state_id=, ?city_id=
  (uuids). A branch-bound key is fixed to its branch; a multi-branch key only
  ever sees its own branches; branch_id outside them -> 400.
}
