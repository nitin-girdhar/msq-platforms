meta {
  name: Reset User Password (Admin)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/users/{{userId}}/reset-password
  body: json
  auth: none
}

headers {
  Cookie: auth_token={{authToken}}
}

body:json {
  {
    "new_password": "ResetPass@1234",
    "send_email_notification": true
  }
}

docs {
  Revokes ALL of the target user's existing sessions immediately (jti-less
  user-scoped blocklist entry). After this call every previously issued token
  for that user is rejected by the gateway and /auth/me until they log in again.

  send_email_notification (optional, default true): when true AND the acting
  admin holds admin.team.notify (or rank >= org_admin), the user is emailed that
  their password was reset. The temporary password is included in that email
  ONLY when it was system-generated (new_password omitted) — never when a
  specific new_password was supplied here.
}
