.env.remote-backup
# keep the example committed
!.env.example
# GPG passphrase for msq-deploy/pg-backup|pg-restore — never commit
.secrets/

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Turbo cache ────────────────────────────────────────────────────────────────
.turbo/

# ── OS artefacts ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Test & coverage ────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker ─────────────────────────────────────────────────────────────────────
docker-compose.override.yml

