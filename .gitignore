/msq-lms/
/msq-hrms/
/msq-todo/
/msq-e2e-validation/

# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build outputs ──────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
*.tsbuildinfo

# ── Environment & secrets ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
