ec2-deploy/deploy.sh

# Everything under msq-deploy/artifacts/ is generated by msq-deploy/build-deploy.ps1
# (merged compose, merged .env.example, copied db_scripts incl. _migrations/,
# deploy.sh, bootstrap-db.sh, the multi-GB image tar). Ignored as a directory
# rather than file-by-file, so newly generated files don't silently show up as
# untracked the next time the bundle layout changes.
msq-deploy/artifacts/
msq-deploy/msq-images.tar
# Per-machine incremental-build cache (repo name -> source fingerprint of its
# last successful build). Local state, never shared.
msq-deploy/.build-state.json
DB_Migration/.gitignore
DB_Migration/export_source.ps1
DB_Migration/README.md
DB_Migration/run_migration.ps1
