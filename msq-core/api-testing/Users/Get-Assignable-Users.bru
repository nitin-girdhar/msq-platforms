meta {
  name: Get Assignable Users
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/users/assignable?product=lms
  body: none
  auth: none
}

headers {
  Cookie: auth_token={{authToken}}
}

params:query {
  product: lms
  ~purpose: filter
  ~org_id: {{orgId}}
  ~org_ids: {{orgId}}
  ~scope: collaboration
  ~max_rank: 40
}
