meta {
  name: Get Assignment Weights
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/users/assignment-weights?campaign_type_id={{campaignTypeId}}
  body: none
  auth: none
}

headers {
  Cookie: auth_token={{authToken}}
}

docs {
  Lists users eligible for auto lead assignment in the caller's org —
  active iam.user_org_mapping rows with role rank strictly between
  read_only (0) and org_admin (80) — along with their current per-
  campaign-type weight (0-100). One row per (user, campaign type) as of
  schema 1.49.0 — the response also carries campaign_type_id/
  campaign_type/campaign_type_label per row.

  campaign_type_id is optional; omit it (and the query string entirely)
  to see every pool this org has. A stale/foreign campaign_type_id is
  rejected with 400 rather than silently returning nothing.

  Use this to review current weights before calling
  Update-Assignment-Weights.bru.
}
