# ─────────────────────────────────────────────────────────────────────────────
# Shared platform core (msq-core) — identity-service, api-gateway,
# admin-service, communication-service, auth-web, lookup-admin.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL connection components ──────────────────────────────────────────
# Change these to point at your Postgres instance. docker-compose.yml reads
# these variables too, so one edit here updates everything.
DB_NAME=crm
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Passw0rd

# Docker container name (used by docker-compose as the network hostname)
DB_CONTAINER_NAME=msq-db-server

# Host path for Postgres data (persistent across container recreates)
DB_DATA_PATH=C:/Girdhar/database_files

# Service-role credentials (created by 01_init-db.sql) — shared pool used by
# identity-service, notifications-service (msq-lms) and admin-service.
DB_LEAD_SVC_USER=lead_svc
DB_LEAD_SVC_PASSWORD=LeadSvc_Dev2025
DB_TENANT_SVC_USER=tenant_dash_svc
DB_TENANT_SVC_PASSWORD=TenantSvc_Dev2025
DB_SERVICE_USER=root_service
DB_SERVICE_PASSWORD=CrmSvc_Dev2025

# Per-product DB login roles (P1.2/D8) are NOT used by msq-core services —
# see msq-lms/msq-hrms/msq-todo's own .env.example for
# DB_LMS_SVC_*/DB_HR_SVC_*/DB_TASK_SVC_*.

# ── Composed DATABASE_URLs (local dev — services outside Docker) ─────────────
# These point at localhost. docker-compose overrides them with the container
# hostname (DB_CONTAINER_NAME) so you never need to touch docker-compose.yml.
DATABASE_URL=postgres://lead_svc:LeadSvc_Dev2025@localhost:5432/crm
DATABASE_URL_TENANT=postgres://tenant_dash_svc:TenantSvc_Dev2025@localhost:5432/crm
DATABASE_URL_SERVICE=postgres://root_service:CrmSvc_Dev2025@localhost:5432/crm

# PostgreSQL pool tuning
PG_MAX=10
PG_IDLE_TIMEOUT=30

# PostgreSQL SSL (production)
PG_SSL_MODE=disable             # Force SSL off (local dev, Docker network)
# PG_SSL_CA_PATH=/path/to/ca.pem  # Path to CA certificate file
# PG_SSL_CA=                    # Inline CA certificate (alternative to PG_SSL_CA_PATH)

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
# JWT_SECRET must be the SAME value across all services that verify tokens —
# including every product repo's services.

# Asymmetric JWT signing (RS256). When set, tokens are signed RS256 and other apps
# can verify them via GET /.well-known/jwks.json without any shared secret. When
# unset, signing/verification falls back to the HS256 JWT_SECRET above.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
#           openssl rsa -in priv.pem -pubout -out pub.pem
# Store PEMs with literal \n escapes on a single line, or as real multiline values.
# JWT_KID=2026-key-1
# JWT_PRIVATE_KEY=   # identity-service only (signing)
# JWT_PUBLIC_KEY=    # api-gateway + identity-service (verification / JWKS) —
#                     # every product service/app also needs this, see their own .env.example

# Completes the RS256 migration. While HS256 is still accepted, RS256 gains you
# nothing security-wise: the RSA private key may live only in identity-service,
# but JWT_SECRET mints equally valid tokens and must be present in every service
# that verifies — so the forgery blast radius stays "anyone who can read
# JWT_SECRET anywhere". Cutover order:
#   1. set JWT_PRIVATE_KEY + JWT_KID (identity-service) and JWT_PUBLIC_KEY everywhere;
#   2. wait one full token lifetime so no HS256 tokens remain in circulation;
#   3. set JWT_ALLOW_HS256=false on EVERY service and web app;
#   4. delete JWT_SECRET from everything that does not sign.
# Only the exact string 'false' disables HS256; anything else keeps it enabled.
# Setting this to false without JWT_PRIVATE_KEY makes identity-service refuse to boot.
JWT_ALLOW_HS256=true

# Inter-service authentication — gateway injects this header, services reject without it
INTERNAL_SERVICE_SECRET=change-me-to-another-long-random-string

# Server-side pepper for hashing public/partner API keys (iam.api_clients,
# owned by identity-service). Must be identical in api-gateway and
# identity-service. REQUIRED in production. Generate: openssl rand -hex 32
PUBLIC_API_KEY_PEPPER=change-me-public-api-pepper

# API key external callers must present on the intake webhook endpoint.
# Required by api-gateway at startup (config.ts) — the process exits without it,
# so the gateway cannot serve at all if this is unset. Minimum 16 characters in
# production. Generate: openssl rand -hex 24
WEBHOOK_API_KEY=change-me-webhook-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Service ports (msq-core services only)
# ─────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
IDENTITY_SERVICE_PORT=4001
COMMUNICATION_SERVICE_PORT=4005
ADMIN_SERVICE_PORT=4006

# ─────────────────────────────────────────────────────────────────────────────
# Shared blob store — identity-service (profile avatars) AND hr-service (punch
# selfies / face reference) mount the SAME volume; hr reads the avatar as the
# CompreFace enrolment reference. These MUST match msq-hrms/.env exactly, or
# hr-service enrols against a directory identity-service never wrote to.
# ─────────────────────────────────────────────────────────────────────────────
BLOB_STORAGE_DRIVER=local
# Directory used by services run NATIVELY (pnpm dev) -- a HOST path, so it is
# OS-specific. docker-compose hardcodes /data/blobs for containers and ignores
# this. msq-hrms/.env MUST name the same directory.
#   Linux:   /deployment/crm/blobs
#   Windows: C:/Girdhar/docker_data/blobs   (forward slashes)
BLOB_STORAGE_DIR=./data/blobs
# Host directory bind-mounted at the container's /data/blobs. Same OS caveat.
BLOB_HOST_PATH=./data/blobs
PHOTO_MAX_BYTES=2097152

# ─────────────────────────────────────────────────────────────────────────────
# Internal service URLs (used by api-gateway to proxy to sibling-repo services,
# and by every product web app's next.config.js `/api/*` rewrite target)
# ─────────────────────────────────────────────────────────────────────────────
API_GATEWAY_INTERNAL_URL=http://localhost:4000
IDENTITY_SERVICE_URL=http://localhost:4001
COMMUNICATION_SERVICE_URL=http://localhost:4005
ADMIN_SERVICE_URL=http://localhost:4006

# Product services (msq-lms/msq-hrms/msq-todo) — point these at wherever
# those repos' containers actually run once the parent workspace's Docker
# network is wired (not solved yet, see docker-compose.yml's note). Ports
# below match each product repo's own .env.example defaults.
LEADS_SERVICE_URL=http://localhost:4002
META_SERVICE_URL=http://localhost:4003
NOTIFICATIONS_SERVICE_URL=http://localhost:4004
HR_SERVICE_URL=http://localhost:4007
TASKS_SERVICE_URL=http://localhost:4008

# ─────────────────────────────────────────────────────────────────────────────
# Outbound request timeouts (milliseconds)
# ─────────────────────────────────────────────────────────────────────────────
# Node's fetch imposes NO timeout of its own. Every value below is optional and
# falls back to the default shown; a non-numeric or non-positive value is
# ignored rather than crashing the service. Do NOT set these to 0 to "disable" —
# that is exactly the unbounded behaviour these exist to remove. Each call site
# gets its own knob because their latency shapes differ; tuning one must not
# move the others.

# api-gateway → any proxied service (default 30000). Covers the slowest
# legitimate work behind the gateway: attendance exports, analytics rollups.
GATEWAY_PROXY_TIMEOUT_MS=30000
# api-gateway → notifications-service SSE (default 10000). Bounds ONLY the wait
# for response headers — the event stream that follows stays open indefinitely.
GATEWAY_SSE_CONNECT_TIMEOUT_MS=10000
# api-gateway → leads-service known-contacts, on the public comms send path
# (default 5000). Fails CLOSED: a timeout blocks the send.
GATEWAY_KNOWN_CONTACTS_TIMEOUT_MS=5000

# identity-service → leads-service reassign-org saga (default 30000). Long,
# because a branch move can reassign many leads, and identity holds the org/role
# change open until it returns.
IDENTITY_LEADS_SERVICE_TIMEOUT_MS=30000

# communication-service → Interakt WhatsApp API (default 10000). Third-party
# egress on a user-facing path — the least trustworthy dependency here.
INTERAKT_TIMEOUT_MS=10000
# leads-service → communication-service (default 15000). MUST exceed
# INTERAKT_TIMEOUT_MS, or this side gives up while the send is still in flight
# and reports a failure for a message the customer already received.
LEADS_COMMUNICATION_SERVICE_TIMEOUT_MS=15000

# meta-conversion-api → leads-service intake (default 10000). Short: this runs
# inside Meta's webhook delivery window, and a slow ack makes Meta retry.
META_LEADS_SERVICE_TIMEOUT_MS=10000

# ─────────────────────────────────────────────────────────────────────────────
# Communication service (email + WhatsApp)
# ─────────────────────────────────────────────────────────────────────────────
# SMTP / Email (all required for email to be enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Your App Name

# WhatsApp via Interakt (required for WhatsApp to be enabled)
INTERAKT_API_KEY=your-interakt-api-key
# INTERAKT_API_BASE_URL=https://api.interakt.ai/v1/public/

# ─────────────────────────────────────────────────────────────────────────────
# Identity service (auth + users)
# ─────────────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# Minimum length enforced for new/changed passwords (identity-service policy).
PASSWORD_MIN_LENGTH=12

# Account-level brute-force lockout. Complements the gateway's per-IP login
# limiter, which an attacker rotating source IPs can evade; this counter lives
# on the account, so it cannot be. After LOGIN_MAX_FAILED_ATTEMPTS consecutive
# failures the account refuses logins for LOGIN_LOCKOUT_MINUTES. The counter
# resets on any successful login, self-service password change, or admin
# password reset (which is also the manual unlock path).
# Set LOGIN_MAX_FAILED_ATTEMPTS=0 to disable lockout entirely.
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# How long a failed attempt stays "recent". Once the previous failure is older
# than this, the counter restarts at 1 instead of accumulating forever — so 9
# failures spread over months don't leave an account one typo from a lockout.
# Defaults to LOGIN_LOCKOUT_MINUTES, which also means an expired lock hands back
# a full budget rather than re-locking on the user's very next mistake.
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# ─────────────────────────────────────────────────────────────────────────────
# App environment
# ─────────────────────────────────────────────────────────────────────────────
# Local dev default. The deploy artifact's .env.example is rewritten to
# `production` by msq-deploy/build-deploy.ps1 — container images are built
# `--prod`, so dev-only deps (pino-pretty) are absent and any other value
# crash-loops every Fastify service.
NODE_ENV=development

# Pino log level for all services: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Web apps (Next.js) — auth-web + lookup-admin live in msq-core.
#   auth-web  → auth.app.com  (login / change-password / select-branch)
# lms-web/hr-web/todo-web live in their own product repos (see that repo's
# .env.example) but share this same SSO cookie/origin config.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# JWT_SECRET (HS256) OR JWT_PUBLIC_KEY (RS256) must be set for middleware.ts Edge
# JWT validation. Product apps should carry JWT_PUBLIC_KEY, never JWT_SECRET.

# Must match PASSWORD_MIN_LENGTH above — drives the password-strength checklist
# shown in the change-password / reset-password forms.
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=12

# SSO cookie scope — the parent domain shared by every product subdomain, so one
# login (at auth.app.com) authenticates all of lms./hr./todo. Leading dot.
# Leave UNSET in single-host local dev (localhost can't set a parent-domain
# cookie) → host-only cookie, single app only.
# COOKIE_DOMAIN=.app.com
# Set true whenever COOKIE_DOMAIN is set (SSO requires HTTPS in real deployments).
COOKIE_SECURE=false

# Cross-app SSO origins (scheme + host). Product apps redirect unauthenticated
# users to NEXT_PUBLIC_AUTH_URL/login and render a product switcher linking the
# others. auth-web validates its post-login callbackUrl against this set.
# Local single-host dev (per-port) defaults:
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_LMS_URL=http://localhost:3001
NEXT_PUBLIC_HR_URL=http://localhost:3002
NEXT_PUBLIC_TASK_URL=http://localhost:3003
# lookup-admin (platform staff tooling). Required by auth-web once lookup-admin
# bounces to the shared auth origin: auth's open-redirect guard only honours a
# callbackUrl whose origin is in this allowlist, so WITHOUT this, staff logging
# in from lookup-admin are silently landed on a product app instead of back on
# the admin console. Deliberately NOT a "product" origin — it never appears in
# the product switcher and is never a default landing destination.
# Local dev publishes lookup-admin on host port 3005 (see docker-compose.yml).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3005
# Subdomain deployment (with the reverse proxy) would instead be, e.g.:
# NEXT_PUBLIC_AUTH_URL=https://auth.app.com
# NEXT_PUBLIC_LMS_URL=https://lms.app.com
# NEXT_PUBLIC_HR_URL=https://hr.app.com
# NEXT_PUBLIC_TASK_URL=https://todo.app.com

# Gateway
WEB_URL=http://localhost:3000

# Number of reverse proxies in front of the gateway, so it can resolve the real
# client IP from X-Forwarded-For — the per-IP rate limiters depend on this.
#   0 = gateway is exposed directly (local dev / `docker compose up`)
#   1 = exactly one proxy in front (the `caddy` profile, or a cloud LB)
# This MUST match your actual topology. Too low collapses every client into one
# rate-limit bucket; too high lets a client spoof its IP and evade the limiter.
TRUST_PROXY_HOPS=0
