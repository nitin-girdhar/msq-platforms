meta {
  name: Switch Org (All Branches)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/switch-org
  body: json
  auth: none
}

headers {
  Cookie: auth_token={{authToken}}
}

body:json {
  {
    "all_branches": true
  }
}

script:post-response {
  if (res.status === 200) {
    const cookies = res.headers['set-cookie'];
    if (cookies) {
      const authCookie = cookies.find(c => c.startsWith('auth_token='));
      if (authCookie) {
        const token = authCookie.split('=')[1].split(';')[0];
        bru.setVar("authToken", token);
      }
    }
    if (res.body.data && res.body.data.user) {
      bru.setVar("orgId", res.body.data.user.org_id);
    }
  }
}

tests {
  test("all_branches session for a tenant-wide actor, else 403", function () {
    if (res.status === 200) {
      expect(res.body.data.user.all_branches).to.equal(true);
    } else {
      expect(res.status).to.equal(403);
    }
  });
}

docs {
  Re-mints the session as "All branches" (JWT branch_scope: 'all',
  session.all_branches = true). Only for users whose My-Orgs lists every
  branch of the tenant (My-Orgs `can_view_all`); anyone else gets 403.

  The token keeps a real org_id (the user's home org) for RLS and writes —
  the claim is a read-filter hint for branch-scoped screens, never a grant.
  This is also the login default for those users.
}
